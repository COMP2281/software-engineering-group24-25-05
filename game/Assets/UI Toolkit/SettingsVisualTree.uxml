<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=807a2b5bfa39f4b479fbe2a51d82c27d&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="startScreen" class="main-menu" style="flex-grow: 1; background-color: rgb(254, 240, 193);">
        <ui:VisualElement name="titleContainer" class="title-container">
            <ui:Label tabindex="-1" text="SETTINGS" parse-escape-sequences="true" display-tooltip-when-elided="true" class="title" />
        </ui:VisualElement>
        <ui:VisualElement name="content" class="content">
            <ui:VisualElement name="leftContainer" class="left-container" style="width: 477px;">
                <ui:Button text="Controls" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ControlsButton" focusable="true" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Button text="Video" parse-escape-sequences="true" display-tooltip-when-elided="true" name="VideoButton" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Button text="Audio" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AudioButton" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Button text="Back" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackButton" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="rightContainer" class="right-container" style="flex-grow: 1; align-items: flex-start;">
                <ui:VisualElement name="controlsPanel" class="settings-panel" style="flex-grow: 1; display: flex; width: 100%; height: 100%;">
                    <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="jumpButton" class="button" style="height: 20%; font-size: 50px; background-color: rgba(58, 94, 91, 0);" />
                    <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="crouchButton" class="button" style="height: 20%; font-size: 50px; background-color: rgba(58, 94, 91, 0);" />
                    <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="rightButton" class="button" style="height: 20%; font-size: 50px; background-color: rgba(58, 94, 91, 0);" />
                    <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="leftButton" class="button" style="height: 20%; font-size: 50px; background-color: rgba(58, 94, 91, 0);" />
                    <ui:Button text="Current: Keyboard &amp; Mouse" parse-escape-sequences="true" display-tooltip-when-elided="true" name="DeviceToggleButton" class="button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; height: 20%; font-size: 50px; background-color: rgba(58, 94, 91, 0);" />
                </ui:VisualElement>
                <ui:VisualElement name="videoPanel" class="settings-panel" style="flex-grow: 1; display: none; width: 100%; height: 100%;">
                    <ui:DropdownField label="Resolution" name="resolutionDropdown" style="font-size: 50px; -unity-font: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); width: auto; margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; -unity-font-style: bold; color: rgb(254, 240, 193);" />
                    <ui:Toggle label="Fullscreen" name="fullscreenToggle" style="width: auto; margin-bottom: 20px; color: rgb(254, 240, 193); margin-top: 20px; margin-right: 20px; margin-left: 20px; font-size: 50px; -unity-font: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="audioPanel" class="settings-panel" style="flex-grow: 1; display: none; width: 100%; height: 100%;">
                    <ui:Slider label="Master Volume" high-value="100" name="masterVolumeSlider" style="margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; color: rgb(254, 240, 193); -unity-font-style: bold; font-size: 50px;" />
                    <ui:Slider label="Music Volume " high-value="100" name="musicVolumeSlider" style="margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; color: rgb(254, 240, 193); -unity-font-style: bold; font-size: 50px;" />
                    <ui:Slider label="SFX Volume    " high-value="100" name="sfxVolumeSlider" style="margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; color: rgb(254, 240, 193); -unity-font-style: bold; font-size: 50px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="RebindOverlay" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.8); position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; display: none;">
        <ui:VisualElement name="RebindPanel" style="background-color: rgb(48, 48, 48); border-radius: 10px; padding: 20px; min-width: 300px; min-height: 150px; justify-content: center; align-items: center;">
            <ui:Label text="Press any key..." display-tooltip-when-elided="true" name="RebindText" style="font-size: 24px; color: rgb(255, 255, 255); -unity-text-align: middle-center; margin-bottom: 10px;" />
            <ui:Label text="Press ESC to cancel" display-tooltip-when-elided="true" style="color: rgb(192, 192, 192); font-size: 14px; -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
