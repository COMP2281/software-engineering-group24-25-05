.title-container {
    width: 100%;
    height: 35%;
    background-color: rgb(58, 94, 91);
    align-items: center;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.title {
    -unity-font-style: bold;
    color: rgb(254, 240, 193);
    -unity-font: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    -unity-font-definition: initial;
    width: 100%;
    height: 100%;
    font-size: 160px;
}

.button {
    font-size: 75px;
    color: rgb(254, 240, 193);
    background-color: rgb(58, 94, 91);
    -unity-text-align: middle-left;
    width: 100%;
    height: 25%;
    -unity-font-style: bold;
}

.content {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.menu {
    width: 45%;
    height: 100%;
    margin-right: 20px;
}

.image-container {
    width: 50%;
    align-items: center;
    justify-content: center;
    background-color: rgb(105, 184, 178);
}

.button:hover {
    background-color: rgb(236, 224, 182);
    scale: 1.02 1.02;
    transform-origin: left;
    transition-duration: 0.2s;
    color: rgb(0, 0, 0);
}

.main-menu {
    background-color: rgb(236, 224, 182);
}

.pause-menu {
    background-color: rgb(0, 0, 0);
    border-top-width: 20px;
    border-right-width: 20px;
    border-bottom-width: 20px;
    border-left-width: 20px;
    margin-top: 250px;
    margin-right: 250px;
    margin-bottom: 250px;
    margin-left: 250px;
    border-left-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
}
