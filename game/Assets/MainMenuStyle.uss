.title-container {
    width: 100%;
    height: 35%;
    background-color: rgb(58, 94, 91);
    align-items: center;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    flex-grow: 1;
}

.title {
    -unity-font-style: bold;
    color: rgb(254, 240, 193);
    -unity-font: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    -unity-font-definition: initial;
    width: 100%;
    height: 100%;
    font-size: 160px;
}

.button {
    font-size: 75px;
    color: rgb(254, 240, 193);
    background-color: rgb(58, 94, 91);
    -unity-text-align: middle-left;
    width: 100%;
    height: 25%;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.2s;
}

.button:hover {
    background-color: rgb(236, 224, 182);
    transition-duration: 0.2s;
    color: rgb(58, 94, 91);
    transition-timing-function: ease-in-out-sine;
}

.content {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.left-container {
    width: 45%;
    height: 100%;
    margin-right: 20px;
    flex-grow: 1;
}

.right-container {
    width: 50%;
    align-items: center;
    justify-content: center;
    background-color: rgb(105, 184, 178);
    flex-grow: 1;
}

.main-menu {
    transition-duration: 0.5s;
    opacity: 1;
}

.pause-menu {
    background-color: rgb(0, 0, 0);
    border-top-width: 20px;
    border-right-width: 20px;
    border-bottom-width: 20px;
    border-left-width: 20px;
    margin-top: 250px;
    margin-right: 250px;
    margin-bottom: 250px;
    margin-left: 250px;
    border-left-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    flex-grow: 1;
    opacity: 0.75;
}

.pause-menu-hidden {
    translate: 0 -1049px;
    opacity: 0;
}

/* Locked button style - normal state */
.locked-button {
    transition: all 0.2s;
    position: relative;
}

/* Locked button hover state */
.locked-button:hover {
    cursor: not-allowed;
    background-color: rgb(224, 81, 50);
    color: rgb(254, 240, 193);
}

/* Unlocked button style */
.unlocked-button {
    transition: all 0.2s;
}

/* Lock icon styling */
.lock-icon {
    position: absolute;
    width: 24px;
    height: 24px;
    right: 10px;
    bottom: 10px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* Notification popup styling */
.notification-popup {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 10px;
    padding: 20px;
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    min-width: 300px;
    min-height: 80px;
    justify-content: center;
    align-items: center;
}

.notification-popup.visible {
    opacity: 1;
}

.notification-popup.hiding {
    opacity: 0;
}
