<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/RebindOverlayStyle.uss?fileID=7433441132597879392&amp;guid=yourguidhere&amp;type=3#RebindOverlayStyle" />
    <ui:VisualElement name="RebindOverlay" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.8); position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center;">
        <ui:VisualElement name="RebindPanel" style="background-color: rgb(48, 48, 48); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; padding-left: 20px; padding-right: 20px; padding-top: 20px; padding-bottom: 20px;">
            <ui:Label text="Press any key..." display-tooltip-when-elided="true" name="RebindText" style="font-size: 24px; color: rgb(255, 255, 255);" />
            <ui:Label text="Press ESC to cancel" display-tooltip-when-elided="true" style="color: rgb(192, 192, 192); font-size: 14px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
